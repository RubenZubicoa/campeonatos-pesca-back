# Puerto HTTP de la API
PORT=4000

# Cadena de MongoDB Atlas, sin nombre de base de datos.
# Atlas -> Database -> Connect -> Drivers -> Node.js
# En Atlas -> Network Access, autoriza la IP desde la que arranca la API.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos dentro del cluster.
MONGO_DB_NAME=campeonatos-pesca

# Origen del front de organización (Vite). Varios orígenes separados por coma.
# Si se deja vacío, la API acepta el origen de la petición.
CORS_ORIGIN=http://localhost:5173
